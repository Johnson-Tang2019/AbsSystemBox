<Page x:Class="SysBox.App.Views.RulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="规则" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="先了解影响，再决定是否执行。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <controls:FeaturePlaceholder Glyph="&#xE9D5;" Description="规则校验、模拟与审批尚未实现。默认只通知，危险操作需要明确确认。" />
        </StackPanel>
    </ScrollViewer>
</Page>
