<Page x:Class="SysBox.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="为你的桌面，添一抹粉色。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="20">
                    <TextBlock Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="粉色主题 · 半透明毛玻璃 · 扁平卡片" Style="{StaticResource BodyCopyStyle}" />
                    <ComboBox x:Name="ThemePicker" Header="应用主题" MinWidth="200" HorizontalAlignment="Left"
                              SelectionChanged="ThemePicker_SelectionChanged" AutomationProperties.AutomationId="ThemePicker">
                        <ComboBoxItem Content="跟随系统" />
                        <ComboBoxItem Content="浅色" />
                        <ComboBoxItem Content="深色" />
                    </ComboBox>
                    <TextBlock x:Name="AppliedThemeText" AutomationProperties.AutomationId="AppliedTheme" Style="{StaticResource BodyCopyStyle}" />
                    <TextBlock Text="主题即时生效并保存。关闭系统透明效果时使用不透明背景。" Style="{StaticResource BodyCopyStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="由你掌控" FontSize="18" FontWeight="SemiBold" />
                    <CheckBox x:Name="BallEnabled" Content="显示内存悬浮球" AutomationProperties.AutomationId="EnableFloatingBall"/>
                    <CheckBox x:Name="TrayEnabled" Content="关闭主窗口后保留托盘（完全退出停止所有任务）" AutomationProperties.AutomationId="EnableTray"/>
                    <ComboBox x:Name="HotKeyPicker" Header="全局快捷搜索键" AutomationProperties.AutomationId="DesktopHotKey"><ComboBoxItem Content="关闭"/><ComboBoxItem Content="Ctrl + Alt + Space"/><ComboBoxItem Content="Ctrl + Alt + Q"/><ComboBoxItem Content="Ctrl + Alt + S"/></ComboBox>
                    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="保存桌面设置" Click="SaveDesktop_Click" AutomationProperties.AutomationId="SaveDesktop"/><Button Content="打开快捷搜索" Click="QuickSearch_Click" AutomationProperties.AutomationId="OpenQuickSearch"/><Button Content="完全退出" Click="Exit_Click" AutomationProperties.AutomationId="ExitApplication"/></StackPanel>
                    <CheckBox x:Name="StartupEnabled" Content="登录 Windows 后启动（仅当前用户）" />
                    <Button Content="保存登录启动设置" Click="Startup_Click"/>
                    <TextBlock x:Name="StartupStatus" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DesktopStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="DesktopStatus"/>
                    <TextBlock Text="默认不自启动、不自动扫描；内存清理默认关闭，请到内存页单独配置并确认。" Style="{StaticResource BodyCopyStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="NTFS 高速增量索引（可选）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="需要管理员通过独立安装工具配置只读服务和卷授权。主程序始终以当前用户运行；服务缺失时，文件搜索页的普通目录扫描仍可用。开启后读取获准整卷的文件名、大小与硬链接元数据，不读取文件正文。" Style="{StaticResource BodyCopyStyle}"/>
                    <TextBox x:Name="NtfsRoot" Header="NTFS 卷根目录" PlaceholderText="例如 D:\；默认不选择、不扫描" AutomationProperties.AutomationId="NtfsRoot"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartNtfs" Content="建立 / 重建整卷索引" Click="StartNtfs_Click" AutomationProperties.AutomationId="StartNtfs"/>
                        <Button Content="停止 / 取消" Click="StopNtfs_Click" AutomationProperties.AutomationId="StopNtfs"/>
                        <Button Content="恢复跟踪" Click="ResumeNtfs_Click" AutomationProperties.AutomationId="ResumeNtfs"/>
                        <Button Content="刷新服务与增量状态" Click="RefreshNtfs_Click" AutomationProperties.AutomationId="RefreshNtfs"/>
                    </StackPanel>
                    <Button Content="配置可选只读服务（管理员确认）" Click="InstallNtfs_Click" AutomationProperties.AutomationId="InstallNtfsService"/>
                    <TextBlock x:Name="NtfsStatus" Text="未启用；不会自动扫描整卷。" TextWrapping="Wrap" AutomationProperties.AutomationId="NtfsStatus"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
