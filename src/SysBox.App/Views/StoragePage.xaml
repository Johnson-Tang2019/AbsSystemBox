<Page x:Class="SysBox.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="磁盘空间" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="空间花在哪里，一层层看清楚。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <controls:FeaturePlaceholder Glyph="&#xEDA2;" Description="文件夹大小、逐层导航与空间分布图尚未实现。未来只分析你选择的目录。" />
        </StackPanel>
    </ScrollViewer>
</Page>
