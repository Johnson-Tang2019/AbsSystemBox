<Page x:Class="SysBox.App.Views.StoragePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <Grid RowSpacing="12" Padding="4,4,4,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="磁盘空间" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="空间花在哪里，一层层看清楚。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SurfaceStyle}">
            <StackPanel Spacing="8">
                <TextBox Text="{x:Bind ViewModel.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="分析文件夹" PlaceholderText="选择一个文件夹，不自动扫描整卷" AutomationProperties.AutomationId="StoragePath" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="选择文件夹" Click="Choose_Click" AutomationProperties.AutomationId="ChooseStorageFolder" />
                        <Button Content="分析 / 重扫" Click="Analyze_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="AnalyzeStorage" />
                        <Button Content="暂停 / 继续" Click="Pause_Click" ToolTipService.ToolTip="暂停目录遍历；最终汇总阶段可取消" AutomationProperties.AutomationId="PauseStorage" />
                        <Button Content="取消" Click="Cancel_Click" AutomationProperties.AutomationId="CancelStorage" />
                        <Button Content="读取已有快照" Click="Read_Click" AutomationProperties.AutomationId="ReadStorage" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageSummary" />
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Content="后退" Click="Back_Click" AutomationProperties.AutomationId="StorageBack" />
            <Button Content="前进" Click="Forward_Click" AutomationProperties.AutomationId="StorageForward" />
            <Button Content="上一级" Click="Up_Click" AutomationProperties.AutomationId="StorageUp" />
            <ComboBox SelectedIndex="0" SelectionChanged="Sort_Changed" AutomationProperties.AutomationId="StorageSort">
                <ComboBoxItem Content="按逻辑大小" /><ComboBoxItem Content="按文件数" />
            </ComboBox>
        </StackPanel>
        <Grid Grid.Row="3" ColumnSpacing="12" SizeChanged="Body_SizeChanged">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <ListView x:Name="ChildrenList" Grid.RowSpan="2" ItemsSource="{x:Bind ViewModel.Children}" IsItemClickEnabled="True" ItemClick="Child_Click" AutomationProperties.AutomationId="StorageChildren">
                <ListView.ItemTemplate>
                    <DataTemplate xmlns:presentation="using:SysBox.Presentation" x:DataType="presentation:StorageRow">
                        <StackPanel Spacing="4" Padding="4">
                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Opacity="0.7" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <controls:StorageTreemap x:Name="SpaceMap" Grid.Column="1" Grid.RowSpan="2" FolderInvoked="Map_FolderInvoked" />
        </Grid>
        <StackPanel Grid.Row="4" Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="上一页" Click="Previous_Click" AutomationProperties.AutomationId="StoragePreviousPage" />
                <Button Content="下一页" Click="Next_Click" IsEnabled="{x:Bind ViewModel.HasMore, Mode=OneWay}" AutomationProperties.AutomationId="StorageNextPage" />
            </StackPanel>
            <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="StorageStatus" />
        </StackPanel>
    </Grid>
</Page>
