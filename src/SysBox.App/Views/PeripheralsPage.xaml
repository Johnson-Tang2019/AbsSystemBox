<Page
    x:Class="SysBox.App.Views.PeripheralsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SysBox.App.Views">
    <Page.Resources>
        <DataTemplate x:Key="PeripheralCardTemplate" x:DataType="local:PeripheralListItem">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8"
                    Padding="14,10" Click="DeviceCard_Click" AutomationProperties.Name="{x:Bind AccessibleName}"
                    AutomationProperties.AutomationId="PeripheralDeviceCard">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyCopyStyle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" />
                </Grid>
            </Button>
        </DataTemplate>
        <DataTemplate x:Key="PeripheralPickerTemplate" x:DataType="local:PeripheralListItem">
            <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
        </DataTemplate>
        <Style x:Key="PeripheralSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
        </Style>
        <Style x:Key="PeripheralValueStyle" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="IsTextSelectionEnabled" Value="True" />
        </Style>
    </Page.Resources>

    <Grid RowSpacing="10" Padding="4,4,4,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="外设" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" VerticalAlignment="Center"
                    Click="Refresh_Click" AutomationProperties.Name="刷新外设"
                    AutomationProperties.AutomationId="PeripheralRefresh" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
            <SelectorBar x:Name="CategorySelector" SelectionChanged="Category_SelectionChanged"
                         AutomationProperties.Name="外设分类" AutomationProperties.AutomationId="PeripheralCategories">
                <SelectorBarItem x:Name="OverviewTab" Text="设备总览" AutomationProperties.AutomationId="PeripheralOverviewTab" />
                <SelectorBarItem x:Name="MouseTab" Text="鼠标" AutomationProperties.AutomationId="PeripheralMouseTab" />
                <SelectorBarItem x:Name="KeyboardTab" Text="键盘" AutomationProperties.AutomationId="PeripheralKeyboardTab" />
                <SelectorBarItem x:Name="GamepadTab" Text="手柄" AutomationProperties.AutomationId="PeripheralGamepadTab" />
            </SelectorBar>
        </ScrollViewer>

        <ProgressBar x:Name="RefreshProgress" Grid.Row="2" Visibility="Collapsed"
                     AutomationProperties.Name="正在检测外设" AutomationProperties.AutomationId="PeripheralRefreshProgress" />

        <ScrollViewer x:Name="ContentScroll" Grid.Row="3" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="16" Padding="0,0,0,12" MaxWidth="900" HorizontalAlignment="Stretch">
                <InfoBar x:Name="ErrorBar" Severity="Error" IsClosable="False" Title="无法刷新设备"
                         AutomationProperties.AutomationId="PeripheralError" />
                <TextBlock x:Name="PageNotice" Style="{StaticResource BodyCopyStyle}" Visibility="Collapsed"
                           AutomationProperties.AutomationId="PeripheralPageNotice" />

                <StackPanel x:Name="Overview" Spacing="12" Visibility="Collapsed">
                    <StackPanel x:Name="MouseSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="鼠标" Style="{StaticResource PeripheralSectionTitleStyle}" />
                        <ItemsControl x:Name="MouseDevices" ItemTemplate="{StaticResource PeripheralCardTemplate}" />
                    </StackPanel>
                    <StackPanel x:Name="KeyboardSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="键盘" Style="{StaticResource PeripheralSectionTitleStyle}" />
                        <ItemsControl x:Name="KeyboardDevices" ItemTemplate="{StaticResource PeripheralCardTemplate}" />
                    </StackPanel>
                    <StackPanel x:Name="GamepadSection" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="手柄" Style="{StaticResource PeripheralSectionTitleStyle}" />
                        <ItemsControl x:Name="GamepadDevices" ItemTemplate="{StaticResource PeripheralCardTemplate}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Details" Spacing="12" Visibility="Collapsed">
                    <ComboBox x:Name="DevicePicker" Header="设备" HorizontalAlignment="Stretch"
                              ItemTemplate="{StaticResource PeripheralPickerTemplate}" SelectionChanged="Device_SelectionChanged"
                              AutomationProperties.AutomationId="PeripheralDevicePicker" Visibility="Collapsed" />
                    <TextBlock x:Name="DetailNotice" Style="{StaticResource BodyCopyStyle}" Visibility="Collapsed"
                               AutomationProperties.AutomationId="PeripheralDetailNotice" />
                    <Border x:Name="DetailCard" Style="{StaticResource SurfaceStyle}" Padding="16" Visibility="Collapsed"
                            AutomationProperties.AutomationId="PeripheralDeviceDetails">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="6">
                                <TextBlock x:Name="DeviceTitle" Style="{StaticResource PeripheralSectionTitleStyle}"
                                           AutomationProperties.AutomationId="PeripheralDeviceName" />
                                <TextBlock x:Name="DeviceStatus" Style="{StaticResource BodyCopyStyle}"
                                           AutomationProperties.AutomationId="PeripheralDeviceStatus" />
                            </StackPanel>
                            <Grid ColumnSpacing="14" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="类型" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceType" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}" />
                                <TextBlock Grid.Row="1" Text="厂商" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceManufacturer" Grid.Row="1" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralDeviceManufacturer" />
                                <TextBlock Grid.Row="2" Text="型号" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceModel" Grid.Row="2" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralDeviceModel" />
                                <TextBlock Grid.Row="3" Text="型号来源" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceModelEvidence" Grid.Row="3" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}" />
                                <TextBlock Grid.Row="4" Text="连接方式" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceConnection" Grid.Row="4" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}" />
                                <TextBlock Grid.Row="5" Text="VID / PID" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceIds" Grid.Row="5" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralDeviceIds" />
                                <TextBlock x:Name="IdentityLabel" Grid.Row="6" Text="硬件身份码" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceIdentityCode" Grid.Row="6" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralIdentityCode" />
                                <TextBlock x:Name="ReceiverNameLabel" Grid.Row="7" Text="接收器名称" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="DeviceReceiverName" Grid.Row="7" Grid.Column="1" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralReceiverName" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="MouseSettings" Spacing="12" Visibility="Collapsed"
                                AutomationProperties.AutomationId="PeripheralMouseSettings">
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="鼠标设置（只读）" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <TextBlock x:Name="MouseReadoutStatus" Style="{StaticResource BodyCopyStyle}" />
                                <TextBlock x:Name="MouseFirmware" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseFirmware" />
                                <TextBlock x:Name="MouseBattery" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseBattery" />
                                <TextBlock x:Name="MouseProfile" Style="{StaticResource PeripheralValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="灵敏度与响应" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <TextBlock x:Name="MouseDpi" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseDpi" />
                                <ComboBox x:Name="MouseDpiPicker" Header="查看 DPI 档位" HorizontalAlignment="Stretch"
                                          AutomationProperties.AutomationId="PeripheralMouseDpiPicker" />
                                <TextBlock x:Name="MousePolling" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMousePolling" />
                                <TextBlock x:Name="MouseLiftOff" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseLiftOff" />
                                <TextBlock x:Name="MouseDebounce" Style="{StaticResource PeripheralValueStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="电源管理" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <TextBlock x:Name="MouseSleep" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseSleep" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="按键映射" Style="{StaticResource PeripheralSectionTitleStyle}"
                                           AutomationProperties.AutomationId="PeripheralMouseMapping" />
                                <ComboBox x:Name="MouseButtonPicker" Header="查看按键" HorizontalAlignment="Stretch"
                                          SelectionChanged="MouseButton_SelectionChanged" />
                                <TextBlock x:Name="MouseButtonAssignment" Style="{StaticResource BodyCopyStyle}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="KeyboardSettings" Spacing="12" Visibility="Collapsed"
                                AutomationProperties.AutomationId="PeripheralKeyboardSettings">
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="键盘设置（只读）" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <TextBlock x:Name="KeyboardReadoutStatus" Style="{StaticResource BodyCopyStyle}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="全键盘灯光" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <TextBlock x:Name="KeyboardEffect" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardEffect" />
                                <TextBlock x:Name="KeyboardBrightness" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardBrightness" />
                                <TextBlock x:Name="KeyboardSpeed" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardSpeed" />
                                <TextBlock x:Name="KeyboardColor" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardColor" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource SurfaceStyle}" Padding="16">
                            <StackPanel Spacing="10">
                                <TextBlock Text="逐键 RGB 与键位映射" Style="{StaticResource PeripheralSectionTitleStyle}" />
                                <ComboBox x:Name="KeyboardKeyPicker" Header="查看物理键位" HorizontalAlignment="Stretch"
                                          SelectionChanged="KeyboardKey_SelectionChanged"
                                          AutomationProperties.AutomationId="PeripheralKeyboardKeyPicker" />
                                <TextBlock x:Name="KeyboardKeyColor" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardPerKeyRgb" />
                                <TextBlock x:Name="KeyboardKeyAssignment" Style="{StaticResource PeripheralValueStyle}"
                                           AutomationProperties.AutomationId="PeripheralKeyboardMapping" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
