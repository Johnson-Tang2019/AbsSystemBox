<Page x:Class="SysBox.App.Views.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="诊断" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="关于当前应用与运行环境。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="AbsSystemBox" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="EnvironmentText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock x:Name="ScaleText" AutomationProperties.AutomationId="UiScale" />
                    <TextBlock x:Name="BatteryText" TextWrapping="Wrap" AutomationProperties.AutomationId="BatterySourceStatus" />
                    <TextBlock Text="许可证：GPL-3.0-or-later" Style="{StaticResource BodyCopyStyle}" />
                    <TextBlock x:Name="HostStatus" Text="正在读取后台健康状态…" TextWrapping="Wrap" AutomationProperties.AutomationId="HostHealth" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="刷新后台健康" Click="Refresh_Click" />
                        <Button x:Name="ExportReport" Content="导出脱敏诊断" Click="Export_Click" AutomationProperties.AutomationId="ExportDiagnostics" />
                    </StackPanel>
                    <TextBlock x:Name="ExportStatus" Text="导出不含索引路径、文件名、进程列表或规则正文。" TextWrapping="Wrap" />
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Title="普通用户模式"
                             Message="无需管理员或外部搜索软件。NTFS 高速索引服务尚未启用；可在索引页选择目录进行普通扫描。" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
