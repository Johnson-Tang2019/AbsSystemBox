<Page x:Class="SysBox.App.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls"
    xmlns:presentation="using:SysBox.Presentation">
    <Page.Resources>
        <x:Double x:Key="ProgressBarTrackHeight">10</x:Double>
        <Style x:Key="OverviewUsageStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0"/><Setter Property="Maximum" Value="100"/>
            <Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="{ThemeResource UsageGradientBrush}"/>
            <Setter Property="Background" Value="{ThemeResource RoseSoftBrush}"/>
        </Style>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12" MaxWidth="1120" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
                <TextBlock Text="概览" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
            </StackPanel>
            <controls:BatteryCard />
            <StackPanel Spacing="16" AutomationProperties.AutomationId="DashboardCards">
                <Border x:Name="MemoryCard" Style="{StaticResource SurfaceStyle}" AutomationProperties.AutomationId="DashboardMemoryCard">
                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE950;" HorizontalAlignment="Left" Foreground="{ThemeResource RoseBrush}" />
                        <TextBlock Text="内存观察" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="DashboardMemoryTitle"/>
                        <TextBlock Text="{Binding MemorySummary}" TextWrapping="Wrap" FontSize="22" FontWeight="SemiBold" />
                        <ProgressBar x:Name="MemoryUsageBar" Style="{StaticResource OverviewUsageStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="DashboardMemoryUsage"/>
                        <TextBlock x:Name="MemoryUsageText" Text="内存用量暂不可用" AutomationProperties.AutomationId="DashboardMemoryUsageText"/>
                        <TextBlock Text="了解内存压力与进程占用" Style="{StaticResource BodyCopyStyle}" />
                        <HyperlinkButton Content="查看内存 →" Tag="memory" Click="Navigate_Click" Padding="0,4" />
                    </StackPanel>
                </Border>
                <Border x:Name="SearchCard" Style="{StaticResource SurfaceStyle}" AutomationProperties.AutomationId="DashboardSearchCard">
                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xE721;" HorizontalAlignment="Left" Foreground="{ThemeResource RoseBrush}" />
                        <TextBlock Text="文件搜索" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="DashboardSearchTitle"/>
                        <TextBlock x:Name="IndexSummary" Text="正在读取索引…" TextWrapping="Wrap" AutomationProperties.AutomationId="DashboardIndex" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="从文件名找到需要的内容" Style="{StaticResource BodyCopyStyle}" />
                        <HyperlinkButton Content="前往搜索 →" Tag="search" Click="Navigate_Click" Padding="0,4" />
                    </StackPanel>
                </Border>
                <Border x:Name="StorageCard" Style="{StaticResource SurfaceStyle}" AutomationProperties.AutomationId="DashboardStorageCard">
                    <StackPanel Spacing="12">
                        <FontIcon Glyph="&#xEDA2;" HorizontalAlignment="Left" Foreground="{ThemeResource RoseBrush}" />
                        <TextBlock Text="磁盘空间" FontSize="18" FontWeight="SemiBold" AutomationProperties.AutomationId="DashboardStorageTitle"/>
                        <TextBlock x:Name="StorageSummary" Text="正在读取容量…" TextWrapping="Wrap" AutomationProperties.AutomationId="DashboardStorage" FontSize="22" FontWeight="SemiBold" />
                        <ItemsControl x:Name="VolumeUsageList" AutomationProperties.AutomationId="DashboardVolumeUsageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="presentation:DashboardVolumeUsage">
                                    <StackPanel Spacing="8" Margin="0,4,0,16" AutomationProperties.AutomationId="DashboardVolumeRow">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" AutomationProperties.AutomationId="DashboardVolumeTitle"/>
                                        <ProgressBar Style="{StaticResource OverviewUsageStyle}" Value="{x:Bind IndicatorValue}" Visibility="{x:Bind HasReading}" AutomationProperties.AutomationId="DashboardVolumeUsage" AutomationProperties.Name="{x:Bind ProgressName}"/>
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" AutomationProperties.AutomationId="DashboardVolumeDetail"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="StorageError" Visibility="Collapsed" TextWrapping="Wrap" AutomationProperties.AutomationId="DashboardStorageError"/>
                        <TextBlock Text="逐层了解文件夹的空间分布" Style="{StaticResource BodyCopyStyle}" />
                        <HyperlinkButton Content="查看磁盘 →" Tag="storage" Click="Navigate_Click" Padding="0,4" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
        </StackPanel>
    </ScrollViewer>
</Page>
