<Page x:Class="SysBox.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="内存" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="了解内存压力，让每一次操作都有依据。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <controls:FeaturePlaceholder Glyph="&#xE950;" Description="内存总量、可用量、提交压力与进程列表将在后续接入。默认只观察，不进行清理。" />
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="16">
                    <Button Content="刷新状态" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RefreshStatus" />
                    <controls:OperationStatus />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
