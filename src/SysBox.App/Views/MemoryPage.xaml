<Page x:Class="SysBox.App.Views.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="MemoryScroll">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="内存" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="观察真实内存与进程占用。仅查询，不清理。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <controls:BatteryCard />
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="{Binding MonitoringButtonText}" Command="{Binding ToggleMonitoringCommand}" AutomationProperties.AutomationId="ToggleMonitoring" />
                        <Button Content="立即刷新" Command="{Binding RefreshCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RefreshStatus" />
                    </StackPanel>
                    <TextBlock Text="{Binding MonitoringStatus}" AutomationProperties.AutomationId="MonitoringStatus" Style="{StaticResource BodyCopyStyle}" />
                    <controls:OperationStatus />
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="16" RowSpacing="16" SizeChanged="Metrics_SizeChanged">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border x:Name="UsageCard" Grid.ColumnSpan="3" Style="{StaticResource SurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="物理内存使用率" Style="{StaticResource BodyCopyStyle}" />
                        <TextBlock Text="{Binding UsageText}" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="PhysicalUsage" />
                        <ProgressBar Value="{Binding UsagePercent}" Maximum="100" />
                        <TextBlock Text="{Binding UsedText}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding TotalSummary}" Style="{StaticResource BodyCopyStyle}" AutomationProperties.AutomationId="TotalMemory" />
                    </StackPanel>
                </Border>
                <Border x:Name="AvailableCard" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource SurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="可用物理内存" Style="{StaticResource BodyCopyStyle}" />
                        <TextBlock Text="{Binding AvailableText}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="AvailableMemory" />
                        <TextBlock Text="包含可立即回收的缓存，不等同于完全空闲。" Style="{StaticResource BodyCopyStyle}" />
                    </StackPanel>
                </Border>
                <Border x:Name="CommitCard" Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource SurfaceStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="系统提交量 / 提交限制" Style="{StaticResource BodyCopyStyle}" />
                        <TextBlock Text="{Binding CommitText}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="CommitMemory" />
                        <TextBlock Text="由系统提交页数计算，与物理内存占用分别计量。" Style="{StaticResource BodyCopyStyle}" />
                    </StackPanel>
                </Border>
            </Grid>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="14">
                    <TextBlock Text="内存使用趋势" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding LastUpdated}" Style="{StaticResource BodyCopyStyle}" AutomationProperties.AutomationId="LastSample" />
                    <controls:MemoryHistoryChart Samples="{Binding History}" />
                    <TextBlock Text="{Binding SampleCount}" Style="{StaticResource BodyCopyStyle}" AutomationProperties.AutomationId="SampleCount" />
                    <TextBlock Text="按实际采样时间绘制，最多保留 60 点；停止后可手动刷新。" Style="{StaticResource BodyCopyStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="16">
                    <TextBlock Text="进程内存" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{Binding ProcessStatus}" Style="{StaticResource BodyCopyStyle}" AutomationProperties.AutomationId="ProcessCoverage" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                        <StackPanel MinWidth="720" Spacing="8">
                            <Grid ColumnSpacing="12" Padding="12,8" Background="{ThemeResource RoseSoftBrush}" CornerRadius="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                <TextBlock Text="名称" /><TextBlock Grid.Column="1" Text="PID" />
                                <TextBlock Grid.Column="2" Text="工作集 ↓" /><TextBlock Grid.Column="3" Text="私有提交" />
                                <TextBlock Grid.Column="4" Text="启动时间" />
                            </Grid>
                            <ListView ItemsSource="{Binding Processes}" Height="360" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ProcessList">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnSpacing="12" Padding="0,6" ToolTipService.ToolTip="{Binding Details}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="120" /><ColumnDefinition Width="120" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProcessId}" />
                                            <TextBlock Grid.Column="2" Text="{Binding WorkingSet}" />
                                            <TextBlock Grid.Column="3" Text="{Binding PrivateBytes}" />
                                            <TextBlock Grid.Column="4" Text="{Binding Identity}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </ScrollViewer>
                    <TextBlock Text="工作集包含共享页，不能相加当作总内存；私有提交不等于私有工作集。启动时间不可取时标记未验证，完整路径在悬停提示中显示。" Style="{StaticResource BodyCopyStyle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
