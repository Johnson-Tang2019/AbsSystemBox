<Page x:Class="SysBox.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SysBox.App.Controls">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
        <StackPanel Spacing="24" Padding="4,4,4,12">
            <StackPanel Spacing="6">
                <TextBlock Text="文件搜索" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="少一点翻找，多一点从容。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
            <controls:FeaturePlaceholder Glyph="&#xE721;" Description="文件名索引与搜索尚未实现。未来由你选择索引范围，不默认读取文件正文。" />
        </StackPanel>
    </ScrollViewer>
</Page>
