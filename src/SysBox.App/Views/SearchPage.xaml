<Page x:Class="SysBox.App.Views.SearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SysBox.Abstractions">
    <Grid RowSpacing="16" Padding="4,4,4,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
        </Grid.RowDefinitions>
            <StackPanel Spacing="6">
                <TextBlock Text="文件索引" Style="{StaticResource PageTitleStyle}" AutomationProperties.AutomationId="PageTitle" />
                <TextBlock Text="由你选择范围，文件仍留在原处。只读取元数据，搜索功能将在下一阶段接入。" Style="{StaticResource BodyCopyStyle}" />
            </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource SurfaceStyle}">
            <StackPanel Spacing="12">
                <ComboBox Header="已有索引范围" ItemsSource="{x:Bind ViewModel.Roots}" DisplayMemberPath="Root" HorizontalAlignment="Stretch" SelectionChanged="Root_SelectionChanged" AutomationProperties.AutomationId="IndexRoots" />
                <TextBox Text="{x:Bind ViewModel.Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="索引文件夹" PlaceholderText="选择或输入一个文件夹路径" AutomationProperties.AutomationId="IndexPath" />
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="选择文件夹" Click="Choose_Click" AutomationProperties.AutomationId="ChooseIndexFolder" />
                        <Button Content="开始 / 重扫" Click="Scan_Click" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="StartIndex" />
                        <Button Content="暂停 / 继续" Click="Pause_Click" AutomationProperties.AutomationId="PauseIndex" />
                        <Button Content="取消" Click="Cancel_Click" AutomationProperties.AutomationId="CancelIndex" />
                        <Button Content="清除索引缓存" Click="Clear_Click" AutomationProperties.AutomationId="ClearIndex" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="IndexStatus" />
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            </StackPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="本次索引预览（最多 100 项；逻辑大小按目录项统计，链接不跟随）" Style="{StaticResource BodyCopyStyle}" />
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Preview}" SelectionMode="None" AutomationProperties.AutomationId="IndexPreview">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:FileEntry">
                    <StackPanel Padding="4" Spacing="2">
                        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis" Opacity="0.7" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
