<Project Sdk="Microsoft.NET.Sdk">
  <!-- Generated from Microsoft's winui template; unpackaged per the official deployment guide. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SysBox.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets/**" CopyToOutputDirectory="PreserveNewest" />
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <ProjectReference Include="../SysBox.Abstractions/SysBox.Abstractions.csproj" />
    <ProjectReference Include="../SysBox.Core/SysBox.Core.csproj" />
    <ProjectReference Include="../SysBox.Memory/SysBox.Memory.csproj" />
    <ProjectReference Include="../SysBox.Rules/SysBox.Rules.csproj" />
    <ProjectReference Include="../SysBox.FileIndex/SysBox.FileIndex.csproj" />
    <ProjectReference Include="../SysBox.Search/SysBox.Search.csproj" />
    <ProjectReference Include="../SysBox.Presentation/SysBox.Presentation.csproj" />
  </ItemGroup>
  <!-- Keep app-generated XAML resources in unpackaged publish output as well as build output. -->
  <Target Name="IncludeCompiledWinUIResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_CompiledWinUIResource Include="$(TargetDir)**\*.xbf;$(TargetDir)$(AssemblyName).pri" Exclude="@(ResolvedFileToPublish)" />
      <ResolvedFileToPublish Include="@(_CompiledWinUIResource)">
        <RelativePath>%(_CompiledWinUIResource.RecursiveDir)%(_CompiledWinUIResource.Filename)%(_CompiledWinUIResource.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
