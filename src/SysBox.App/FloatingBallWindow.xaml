<Window x:Class="SysBox.App.FloatingBallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AbsSystemBox 悬浮球">
<Grid x:Name="Ball" Background="Transparent" PointerPressed="Ball_Pressed" PointerMoved="Ball_Moved" PointerReleased="Ball_Released" PointerEntered="Ball_Entered" PointerExited="Ball_Exited" PointerCaptureLost="Ball_CaptureLost" RightTapped="Ball_RightTapped" ToolTipService.ToolTip="单击打开主窗口，双击请求清理，拖动贴边" AutomationProperties.AutomationId="FloatingBall" AutomationProperties.Name="悬浮球；单击打开主窗口、双击请求清理、拖动贴边，右键打开主窗口">
<Grid x:Name="FullBall" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource FloatingSurfaceBrush}" IsHitTestVisible="False">
<ProgressRing x:Name="Ring" Width="60" Height="60" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Foreground="{ThemeResource RoseBrush}" Background="{ThemeResource RoseSoftBrush}"/>
<TextBlock x:Name="Percent" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
</Grid>
<Grid x:Name="EdgeBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{ThemeResource RoseSoftBrush}" IsHitTestVisible="False"><Border x:Name="BarFill" Background="{ThemeResource RoseBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/></Grid>
</Grid></Window>
