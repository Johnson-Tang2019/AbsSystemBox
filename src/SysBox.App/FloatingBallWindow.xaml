<Window x:Class="SysBox.App.FloatingBallWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AbsSystemBox 悬浮球">
<Window.SystemBackdrop><DesktopAcrylicBackdrop/></Window.SystemBackdrop>
<Grid x:Name="Ball" Background="{ThemeResource ShellTintBrush}" PointerPressed="Ball_Pressed" PointerMoved="Ball_Moved" PointerReleased="Ball_Released" PointerEntered="Ball_Entered" PointerExited="Ball_Exited" PointerCaptureLost="Ball_CaptureLost" AutomationProperties.AutomationId="FloatingBall" AutomationProperties.Name="内存悬浮球；单击清理、双击主窗口、拖动贴边，右键菜单">
<Grid.ContextFlyout><MenuFlyout Opening="Menu_Opening" Closed="Menu_Closed"><MenuFlyoutItem Text="内存清理…" Click="Clean_Click"/><MenuFlyoutItem Text="打开主窗口" Click="Main_Click"/><MenuFlyoutItem Text="快捷搜索" Click="Search_Click"/><MenuFlyoutItem Text="隐藏悬浮球" Click="Hide_Click"/><MenuFlyoutItem Text="完全退出" Click="Exit_Click"/></MenuFlyout></Grid.ContextFlyout>
<Grid x:Name="FullBall" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
<ProgressRing x:Name="Ring" Width="60" Height="60" IsIndeterminate="False" IsActive="True" Minimum="0" Maximum="100" Foreground="{ThemeResource RoseBrush}" Background="{ThemeResource RoseSoftBrush}"/>
<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock x:Name="Percent" Text="—" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="内存" FontSize="9" HorizontalAlignment="Center"/></StackPanel>
</Grid>
<Grid x:Name="EdgeBar" Visibility="Collapsed" Background="{ThemeResource RoseSoftBrush}" IsHitTestVisible="False"><Border x:Name="BarFill" Background="{ThemeResource RoseBrush}" VerticalAlignment="Bottom" HorizontalAlignment="Left"/></Grid>
</Grid></Window>
