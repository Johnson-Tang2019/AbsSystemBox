<UserControl x:Class="SysBox.App.Controls.MemoryCleanupPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Spacing="16">
            <Border Style="{StaticResource SurfaceStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="内存清理（默认关闭）" Style="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Text="Fluent Reduct 自动清理默认阈值 90%、间隔 30 分钟。这里的自动清理仅处理允许的进程工作集；九类系统清理每次均需下方独立管理员确认。" TextWrapping="Wrap"/>
                    <TextBlock Text="仅调整你允许的当前用户后台进程工作集，可能增加后续调页。排除前台、系统、提升权限、其他会话和启动未满 120 秒的进程；每轮至多 2 项，每小时至多 6 轮。不会清空系统缓存或 Standby List。" Style="{StaticResource BodyCopyStyle}"/>
                    <CheckBox x:Name="CleanupEnabled" Content="启用自动清理（保存时需要确认）" AutomationProperties.AutomationId="CleanupEnabled"/>
                    <CheckBox x:Name="ThresholdEnabled" Content="阈值清理" IsChecked="True" AutomationProperties.AutomationId="ThresholdCleanup"/>
                    <NumberBox x:Name="CleanupThreshold" Header="内存使用率阈值（%）" Value="90" Minimum="50" Maximum="98"/>
                    <NumberBox x:Name="CleanupHold" Header="持续超过阈值的秒数" Value="45" Minimum="10" Maximum="3600"/>
                    <CheckBox x:Name="PeriodicEnabled" Content="定期清理（内存使用率至少 50% 才执行）" AutomationProperties.AutomationId="PeriodicCleanup"/>
                    <NumberBox x:Name="CleanupPeriod" Header="定期间隔（分钟）" Value="30" Minimum="5" Maximum="1440"/>
                    <NumberBox x:Name="CleanupCooldown" Header="两轮之间的最短冷却（秒）" Value="300" Minimum="60" Maximum="86400"/>
                    <NumberBox x:Name="CleanupMinimum" Header="目标进程最小工作集（MiB）" Value="256" Minimum="64" Maximum="65536"/>
                    <TextBox x:Name="CleanupNames" Header="允许处理的进程名，以逗号分隔" PlaceholderText="例如 chrome.exe；为空时不允许启用" AutomationProperties.AutomationId="CleanupNames"/>
                    <Button x:Name="SaveCleanup" Content="保存清理设置" Click="SaveCleanup_Click" AutomationProperties.AutomationId="SaveCleanup"/>
                    
                    <TextBlock x:Name="CleanupStatus" TextWrapping="Wrap" AutomationProperties.AutomationId="CleanupStatus"/>
                </StackPanel>
            </Border>
<Border Style="{StaticResource SurfaceStyle}"><StackPanel Spacing="12">
<TextBlock Text="系统内存清理" Style="{StaticResource SubtitleTextBlockStyle}"/>
<TextBlock Text="按 Fluent Reduct 的九类清理及执行顺序实现。执行时需单独管理员确认；系统缓存和 Standby 操作可能短暂停顿。" TextWrapping="Wrap"/>
<StackPanel x:Name="AreaOptions" Spacing="4"/>
<Button Content="执行所选清理…" Click="CleanSystem_Click" AutomationProperties.AutomationId="CleanSystemMemory"/>
<TextBlock x:Name="SystemResult" TextWrapping="Wrap" AutomationProperties.AutomationId="SystemCleanupResult"/>
</StackPanel></Border></StackPanel></UserControl>
