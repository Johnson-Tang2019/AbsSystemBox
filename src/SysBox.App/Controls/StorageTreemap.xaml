<UserControl x:Class="SysBox.App.Controls.StorageTreemap"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="TileA" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource RoseSoftBrush}" />
        </Style>
        <Style x:Key="TileB" TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource SoftSurfaceBrush}" />
        </Style>
    </UserControl.Resources>
    <Canvas x:Name="Tiles" Background="{ThemeResource SoftSurfaceBrush}" SizeChanged="Tiles_SizeChanged" AutomationProperties.AutomationId="StorageTreemap" />
</UserControl>
