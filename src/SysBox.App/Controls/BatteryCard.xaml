<UserControl x:Class="SysBox.App.Controls.BatteryCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Card" Style="{StaticResource SurfaceStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="ChargingBatteryCard">
        <StackPanel Spacing="8">
            <TextBlock Text="笔记本正在充电" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="电池净充电功率" Style="{StaticResource BodyCopyStyle}" />
            <TextBlock Text="{Binding PowerText}" FontSize="28" Foreground="{ThemeResource RoseBrush}" AutomationProperties.AutomationId="BatteryChargePower" />
            <TextBlock Text="{Binding TimeText}" TextWrapping="Wrap" AutomationProperties.AutomationId="BatteryTimeToFull" />
            <TextBlock Text="按当前速率估算；临近充满时可能变慢。功率为电池净输入，不是充电器总输出。" Style="{StaticResource BodyCopyStyle}" />
        </StackPanel>
    </Border>
</UserControl>
