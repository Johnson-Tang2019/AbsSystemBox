<UserControl x:Class="SysBox.App.Controls.OperationStatus"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="12">
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ProgressRing IsActive="{Binding IsBusy}" Width="20" Height="20" AutomationProperties.Name="正在读取状态" />
            <TextBlock Grid.Column="1" Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            <Button Grid.Column="2" Content="取消" Command="{Binding CancelCommand}" AutomationProperties.AutomationId="CancelOperation" />
        </Grid>
        <InfoBar IsOpen="{Binding HasError, Mode=OneWay}" IsClosable="False" Severity="Informational"
                 Title="暂未就绪" Message="{Binding ErrorMessage}" AutomationProperties.AutomationId="OperationError" />
    </StackPanel>
</UserControl>
