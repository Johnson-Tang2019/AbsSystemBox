<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SysBox.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SysBox.App"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="AbsSystemBox"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource ShellTintBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Title="AbsSystemBox">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView x:Name="Navigation" Grid.Row="1"
                        PaneDisplayMode="Auto" OpenPaneLength="232" CompactPaneLength="56"
                        IsSettingsVisible="False" IsBackButtonVisible="Collapsed"
                        AlwaysShowHeader="False" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,8,12,24">
                    <Border Background="{ThemeResource RoseSoftBrush}" CornerRadius="10" Width="36" Height="36">
                        <FontIcon Glyph="&#xE80F;" FontSize="18" Foreground="{ThemeResource RoseBrush}" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="系统工具箱" FontWeight="SemiBold" />
                        <TextBlock Text="轻盈 · 清晰 · 可控" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem Content="概览" Tag="dashboard" Icon="Home" AutomationProperties.AutomationId="NavDashboard" />
                <NavigationViewItem Content="内存" Tag="memory" AutomationProperties.AutomationId="NavMemory"><NavigationViewItem.Icon><FontIcon Glyph="&#xE950;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="文件搜索" Tag="search" Icon="Find" AutomationProperties.AutomationId="NavSearch" />
                <NavigationViewItem Content="磁盘空间" Tag="storage" AutomationProperties.AutomationId="NavStorage"><NavigationViewItem.Icon><FontIcon Glyph="&#xEDA2;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="规则" Tag="rules" AutomationProperties.AutomationId="NavRules"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D5;" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="诊断" Tag="diagnostics" AutomationProperties.AutomationId="NavDiagnostics"><NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="NavSettings" />
            </NavigationView.FooterMenuItems>
            <Grid Padding="24,12,24,24" RowSpacing="12">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar x:Name="DemoBanner" IsOpen="False" IsClosable="False" Severity="Warning"
                         Title="示例预览" Message="这里的数据为模拟数据，不代表本机状态。" />
                <Frame x:Name="RootFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
