<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="SystemAccentColor">#B52D68</Color>
            <Color x:Key="SystemAccentColorDark1">#9E2459</Color>
            <Color x:Key="SystemAccentColorDark2">#861A49</Color>
            <Color x:Key="SystemAccentColorDark3">#6D143B</Color>
            <Color x:Key="SystemAccentColorLight1">#CA4C82</Color>
            <Color x:Key="SystemAccentColorLight2">#E27AA6</Color>
            <Color x:Key="SystemAccentColorLight3">#F7BED7</Color>
            <SolidColorBrush x:Key="ShellTintBrush" Color="#D9FFF2F8" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#BDFFFFFF" />
            <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#6EFFFFFF" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#24B52D68" />
            <SolidColorBrush x:Key="RoseBrush" Color="#B52D68" />
            <SolidColorBrush x:Key="RoseSoftBrush" Color="#1CB52D68" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <Color x:Key="SystemAccentColor">#FF9FC8</Color>
            <Color x:Key="SystemAccentColorDark1">#DF78A6</Color>
            <Color x:Key="SystemAccentColorDark2">#C15B8B</Color>
            <Color x:Key="SystemAccentColorDark3">#A44172</Color>
            <Color x:Key="SystemAccentColorLight1">#FFB8D8</Color>
            <Color x:Key="SystemAccentColorLight2">#FFD1E6</Color>
            <Color x:Key="SystemAccentColorLight3">#FFE9F2</Color>
            <SolidColorBrush x:Key="ShellTintBrush" Color="#662B1725" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#BD30272F" />
            <SolidColorBrush x:Key="SoftSurfaceBrush" Color="#6E30272F" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#38FF9FC8" />
            <SolidColorBrush x:Key="RoseBrush" Color="#FF9FC8" />
            <SolidColorBrush x:Key="RoseSoftBrush" Color="#26FF9FC8" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShellTintBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SoftSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="RoseBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="RoseSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="SurfaceStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
    </Style>
    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.HeadingLevel" Value="Level1" />
    </Style>
    <Style x:Key="BodyCopyStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
</ResourceDictionary>
