{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johnson-Tang2019/AbsSystemBox/blob/main/docs/api/cli-response.schema.json",
  "title": "SysBox CLI response envelope 1.0",
  "oneOf": [
    {
      "type": "object",
      "required": ["apiVersion", "ok", "data"],
      "additionalProperties": false,
      "properties": {"apiVersion": {"const": "1.0"}, "ok": {"const": true}, "data": {}}
    },
    {
      "type": "object",
      "required": ["apiVersion", "ok", "error"],
      "additionalProperties": false,
      "properties": {
        "apiVersion": {"const": "1.0"},
        "ok": {"const": false},
        "error": {
          "type": "object",
          "required": ["code", "message", "details", "retryable"],
          "additionalProperties": false,
          "properties": {
            "code": {"type": "string", "minLength": 1},
            "message": {"type": "string", "minLength": 1},
            "details": {"type": ["string", "null"]},
            "retryable": {"type": "boolean"}
          }
        }
      }
    }
  ]
}
